# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored -- NEVER commit it. On Render, set these in the
# service's Environment tab instead.

# Postgres with pgvector, e.g. a free Neon database (neon.com).
# Use the connection string Neon shows you (it ends with ?sslmode=require).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# dashboard.cohere.com -> API Keys
COHERE_API_KEY=

# elevenlabs.io -> Developers -> API Keys
ELEVENLABS_API_KEY=

# Optional: which websites may call this API (comma separated)
# FRONTEND_ORIGINS=https://swarsmriti-1.onrender.com,http://localhost:5173